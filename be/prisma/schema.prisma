// Prisma schema for Inventory & Reports app
// Database: MongoDB Atlas
// ORM: Prisma 6.x

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum MovementType {
  IN
  OUT
}

enum UserRole {
  ADMIN
  STAFF
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  sku         String          @unique
  name        String
  description String?
  categoryId  String          @db.ObjectId
  price       Float
  quantity    Int             @default(0)
  threshold   Int             @default(10)
  unit        String          @default("pcs")
  imageUrl    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  category    Category        @relation(fields: [categoryId], references: [id])
  movements   StockMovement[]

  @@map("products")
}

model StockMovement {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  productId String       @db.ObjectId
  type      MovementType
  quantity  Int
  note      String?
  reference String? // e.g. PO number, invoice number
  createdBy String? // user ID who performed this
  createdAt DateTime     @default(now())
  product   Product      @relation(fields: [productId], references: [id])

  @@map("stock_movements")
}
